# Wallet private key (testnet only! Generate with: cast w new)
PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY

# Wallet address to receive payments (the services' payTo address)
PAY_TO_ADDRESS=0x_YOUR_ADDRESS

# OpenAI API key for LLM synthesis (or use Anthropic)
OPENAI_API_KEY=sk-...

# Service ports
FACILITATOR_PORT=4400
WEATHER_PORT=4401
NEWS_PORT=4402
ANALYTICS_PORT=4403
WEB_PORT=3000

# Agent budget in USD
AGENT_BUDGET=1.00

# Network (Base Sepolia testnet)
NETWORK=eip155:84532

# Facilitator URL
FACILITATOR_URL=https://facilitator.x402.org